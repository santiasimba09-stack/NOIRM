{
  "format_version": "1.8.0",
  "animations": {
    "idle": {
      "loop": true,
      "animation_length": 4,
      "bones": {
        "body": {
          "rotation": [
            0,
            0,
            "math.sin(query.anim_time * 90) * 0.6"
          ]
        }
      }
    },
    "walk": {
      "loop": true,
      "animation_length": 1,
      "bones": {
        "left_leg": {
          "rotation": [
            "math.sin(query.anim_time * 360) * 28",
            0,
            0
          ]
        },
        "right_leg": {
          "rotation": [
            "math.sin(query.anim_time * 360) * -28",
            0,
            0
          ]
        },
        "left_arm": {
          "rotation": [
            "math.sin(query.anim_time * 360) * -18",
            0,
            0
          ]
        },
        "right_arm": {
          "rotation": [
            "math.sin(query.anim_time * 360) * 18",
            0,
            0
          ]
        }
      }
    },
    "attack": {
      "animation_length": 0.5,
      "bones": {
        "right_arm": {
          "rotation": {
            "0": [
              0,
              0,
              0
            ],
            ".2": [
              -95,
              0,
              -15
            ],
            ".5": [
              0,
              0,
              0
            ]
          }
        }
      }
    }
  }
}